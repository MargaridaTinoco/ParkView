# Copia este ficheiro para db/.env e preenche com os valores do botão "Connect" do TiDB Cloud.
# O db/.env NÃO vai para o git (está no .gitignore).
TIDB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=xxxxxxxx.root
TIDB_PASSWORD=
TIDB_DATABASE=parkview
# Opcional: caminho para um certificado CA. Vazio = usar os certificados do Windows.
TIDB_CA=
